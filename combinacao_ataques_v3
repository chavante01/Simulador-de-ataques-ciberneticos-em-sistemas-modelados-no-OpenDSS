def plot_attack_regions(time_vector, step_size,
                        color='red',
                        label="Ataque",
                        shrink_last_step=False):
    in_attack = False
    first_label_used = False

    for i in range(len(time_vector)):
        if time_vector[i] == 1 and not in_attack:
            start = i
            in_attack = True

        elif time_vector[i] == 0 and in_attack:
            end = i

            # decide até onde vai o sombreado
            if shrink_last_step:
                x_end = (end - 1) * step_size
            else:
                x_end = end * step_size

            plt.axvspan(start * step_size,
                        x_end,
                        color=color,
                        alpha=0.25,
                        label=label if not first_label_used else "")

            first_label_used = True
            in_attack = False

    # caso termine em ataque
    if in_attack:
        if shrink_last_step:
            x_end = (len(time_vector) - 1) * step_size
        else:
            x_end = len(time_vector) * step_size

        plt.axvspan(start * step_size,
                    x_end,
                    color=color,
                    alpha=0.25,
                    label=label if not first_label_used else "")

