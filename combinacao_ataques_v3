def build_Gamma(n_total, selecionados):
    """
    n_total: número total de canais (sensores ou atuadores)
    selecionados: lista de índices (0-based) dos canais atacados
    retorna: Gamma (n_total x r), onde r = len(selecionados)
    """
    if selecionados is None:
        selecionados = []
    else:
        selecionados = [int(x) for x in selecionados]
    validos = []
    for idx in selecionados:
        if 0 <= idx < n_total:
            validos.append(idx)
        else:
            print(f" Índice inválido ignorado: {idx}")

    r = len(validos)
    if r == 0:
        return np.zeros((n_total, 0)), []

    Gamma = np.zeros((n_total, r), dtype=float)
    for col, idx in enumerate(validos):
        Gamma[idx, col] = 1.0
    return Gamma, validos

def selecionar_alvos():
    # Dicionário de sensores
    sensores = {
        0: "SOC da Bateria",
        1: "Energia da Bateria (kWh)",
        2: "Potência Ativa da Bateria (kW)",
        3: "Tensão da Bateria (V)",
        4: "Corrente da Bateria (A)",
        5: "Potência Aparente da Bateria (kVA)"
    }

    # Dicionário de atuadores
    atuadores = {
        0: "SOC Máximo da Bateria",
        1: "SOC Mínimo da Bateria",
        2: "kW_ref da Bateria",
        3: "Idling_kW da Bateria"
    }

    # ---- Sensores ----
    print("\nSensores disponíveis para ataque:")
    for idx, nome in sensores.items():
        print(f"[{idx}]: {nome}")
    entrada_sensores = input("\nDigite os índices dos sensores para ataque (ex: 0,2,4): ").strip()
    selecionados_sensores = [] if entrada_sensores == "" else [int(x) for x in entrada_sensores.split(",")]

    # ---- Atuadores ----
    print("\nAtuadores disponíveis para ataque:")
    for idx, nome in atuadores.items():
        print(f"[{idx}]: {nome}")
    entrada_atuadores = input("\nDigite os índices dos atuadores para ataque (ex: 0,2): ").strip()
    selecionados_atuadores = [] if entrada_atuadores == "" else [int(x) for x in entrada_atuadores.split(",")]

    # constroem as Γ compactas
    Gamma_y, selec_y = build_Gamma(6, selecionados_sensores)  # (6, r_y)
    Gamma_u, selec_u = build_Gamma(4, selecionados_atuadores) # (4, r_u)

    return Gamma_y, Gamma_u, selec_y, selec_u

