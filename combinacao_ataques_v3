        Gera ataques INDIVIDUAIS para cada sensor e atuador
        """
        # Para cada sensor (6 elementos) - ataque independente
        resultado_sensores = []
        for prob in prob_sensores:
            aleatorio = random.random()
            resultado_sensores.append(1 if aleatorio < prob else 0)
        
        # Para cada atuador (4 elementos) - ataque independente  
        resultado_atuadores = []
        for prob in prob_atuadores:
            aleatorio = random.random()
            resultado_atuadores.append(1 if aleatorio < prob else 0)
            
        return np.array(resultado_sensores), np.array(resultado_atuadores)
 
    # ⚠️ CORREÇÃO: Use arrays para as probabilidades
    resultado_sensores, resultado_atuadores = bernoulli_individual(prob_bernoulli_sensores, prob_bernoulli_atuadores)

    # Matrizes de ataque DoS (dimensionadas pelos canais atacáveis)
    m = Gamma_y.shape[1]   # nº de colunas de Gamma_y
    p = Gamma_u.shape[1]   # nº de colunas de Gamma_u

    Sky = np.diag(np.asarray(resultado_sensores, dtype=float)[:m])  # (m x m)
    Sku = np.diag(np.asarray(resultado_atuadores, dtype=float)[:p])  # (p x p)


    # DETECTA TRANSIÇÃO 0→1 PARA CADA COMPONENTE INDIVIDUALMENTE
    for i in range(len(resultado_sensores)):
        if resultado_sensores[i] == 1 and estado_anterior_sensores[i] == 0:
            # usa o ÚLTIMO valor válido (antes do ataque), não o atual
            y_tau_y[i, 0] = y_prev[i, 0]

    for i in range(len(resultado_atuadores)):
        if resultado_atuadores[i] == 1 and estado_anterior_atuadores[i] == 0:
            u_tau_u[i, 0] = u_prev[i, 0]

    # Indicador global (algum canal sob ataque neste k)
    resultado = 1 if (resultado_sensores.any() or resultado_atuadores.any()) else 0
        
    # Atualiza estados anteriores para a próxima chamada
    estado_anterior_sensores = resultado_sensores.copy()
    estado_anterior_atuadores = resultado_atuadores.copy()

    Gamma_y_transposta = Gamma_y.T  #matriz gama y maiúsculo transposta
    subtracaoy = soma_corrupcao_yk - y_tau_y #diferença entre o sinal que deveria ser injetado no controlador e o último sinal medido antes do ataque   
    multiplicacao1y = np.dot(Sky, Gamma_y_transposta)  #multiplicação entre a matriz que indica se o ataque está ocorrendo em determinado tempo k e a matriz que mostra os sensores que o aversário domina
    multiplicacao2y = np.dot(multiplicacao1y, subtracaoy)
    byk = multiplicacao2y * -1  #matriz resultante do ataque DoS
    multiplicacao3y = np.dot(Gamma_y , byk)
    y_til_k = soma_corrupcao_yk + multiplicacao3y  #Sinal dos sensores negado 
    
    Gamma_u_transposta = Gamma_u.T  #matriz gama y maiúsculo transposta
    subtracaou = soma_corrupcao_uk - u_tau_u #diferença entre o sinal que deveria ser injetado no controlador e o último sinal medido antes do ataque   
    multiplicacao1u = np.dot(Sku, Gamma_u_transposta)  #multiplicação entre a matriz que indica se o ataque está ocorrendo em determinado tempo k e a matriz que mostra os sensores que o aversário domina
    multiplicacao2u = np.dot(multiplicacao1u, subtracaou)
    buk = multiplicacao2u * -1  #matriz resultante do ataque DoS
    multiplicacao3u = np.dot(Gamma_u , buk)
    u_til_k = soma_corrupcao_uk + multiplicacao3u  #Sinal dos sensores negado 

    # salvar somente quando há ataque
    for i in range(ny):
        mask_dos_sensores[i].append(int(resultado_sensores[i]))
        if resultado_sensores[i] == 1:
            sens_t[i].append(k_step)
            sens_y[i].append(float(y_til_k[i, 0]))

    for j in range(nu):
        mask_dos_atuadores[j].append(int(resultado_atuadores[j]))
        if resultado_atuadores[j] == 1:
            atu_t[j].append(k_step)
            atu_u[j].append(float(u_til_k[j, 0]))
    
    soc_ataque_combinado.append(float(y_til_k[0].item()))
    kwh_ataque_combinado.append(float(y_til_k[1].item()))
    kW_ataque_combinado.append(float(y_til_k[2].item()))
    tensao_ataque_combinado.append(float(y_til_k[3].item()))
    corrente_ataque_combinado.append(float(y_til_k[4].item()))
    kVA_ataque_combinado.append(float(y_til_k[5].item()))
    soc_max_ataque_combinado.append(float(u_til_k[0].item())) 
    soc_min_ataque_combinado.append(float(u_til_k[1].item()))
    kW_ref_ataque_combinado.append(float(u_til_k[2].item()))
    idling_kW_ataque_combinado.append(float(u_til_k[3].item()))

    # após calcular y_til_k e u_til_k (ou mesmo após os appends)
    y_prev = soma_corrupcao_yk.copy()
    u_prev = soma_corrupcao_uk.copy()

    return u_til_k, y_til_k

def aplicar_degradacao_soc(soc_max_atual, soc_min_atual, taxa_degradacao, limite_superior=60, limite_inferior=40):
    novo_soc_max = max(soc_max_atual - taxa_degradacao, limite_superior)
    novo_soc_min = min(soc_min_atual + taxa_degradacao, limite_inferior)
    return novo_soc_max, novo_soc_min

