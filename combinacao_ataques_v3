    # Atualiza estados anteriores
    estado_anterior_sensores = resultado_sensores.copy()
    estado_anterior_atuadores = resultado_atuadores.copy()

    Gamma_y_transposta = Gamma_y.T
    subtracaoy = yk - y_tau_y
    byk = - np.dot(Sky, np.dot(Gamma_y_transposta, subtracaoy))  # (m x 1)
    corrupcao_yk_DoS = np.dot(Gamma_y, byk)                      # (ny x 1)
    y_til_k = yk + corrupcao_yk_DoS

    Gamma_u_transposta = Gamma_u.T
    subtracaou = uk - u_tau_u
    buk = - np.dot(Sku, np.dot(Gamma_u_transposta, subtracaou))  # (p x 1)
    corrupcao_uk_DoS = np.dot(Gamma_u, buk)                      # (nu x 1)
    u_til_k = uk + corrupcao_uk_DoS

    # salvar somente quando há ataque
