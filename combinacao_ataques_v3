    y_prev = yk.copy()
    u_prev = uk.copy()

    return y_til_k, u_til_k, corrupcao_yk_DoS, corrupcao_uk_DoS
     
def replay_attack():
    """
    k0 é o começo da gravação de dados.
    grava de k0 <= x <= kr.
    repete de kr < x <= kf.
    Implementação simples: salva vetores completos yk/uk e, no replay,
    sobrescreve apenas as componentes atacadas.
    """
    global lk_lista_y, lk_lista_u, x, i_y, i_u, k0, kr, kf
    global soc_ataque, kWh_bateria, kW_bateria, kVA_bateria, tensao_bateria, corrente_bateria
    global soc_min, soc_max, kW_ref, Idling_kW, Gamma_y, Gamma_u

    # lê sensores/atuadores como antes
    dss.circuit._set_active_element("Storage.Bateria")
    soc_ataque = float(dss.dssproperties._value_read("23"))
    kWh_bateria = float(dss.dssproperties._value_read("22"))
    kW_bateria = dss.cktelement._powers()
    kVA_bateria = math.sqrt((kW_bateria[0]**2) + (kW_bateria[1]**2))
    tensao_bateria = dss.cktelement._voltages()
    corrente_bateria = dss.cktelement._currents()

    kW_ref = float(dss.dssproperties._value_read("5"))
    Idling_kW = float(dss.dssproperties._value_read("30"))

    # cria vetores coluna na forma (n,1)
    yk = np.array([
        [soc_ataque],
        [kWh_bateria],
        [kW_bateria[0]],
        [tensao_bateria[0]],
        [corrente_bateria[0]],
        [kVA_bateria]
    ])
    uk = np.array([
        [soc_max],
        [soc_min],
        [kW_ref],
        [Idling_kW]
    ])

    # indices atacados (linhas onde Gamma tem algum 1)
    attacked_y_idx = np.where(Gamma_y.sum(axis=1) > 0)[0] 
    attacked_u_idx = np.where(Gamma_u.sum(axis=1) > 0)[0]

    # Fase 1: gravação (guarda vetores completos)
    if k0 <= x <= kr:
        lk_lista_y.append(yk.copy())   # salva 6x1 completo
        lk_lista_u.append(uk.copy())   # salva 4x1 completo
        mask_replay_coleta.append(1)

    # Fase 2: replay
    elif kr < x <= kf:
        # se houver gravações, repetimos ciclicamente
        if len(lk_lista_y) > 0:
            if i_y >= len(lk_lista_y):
                i_y = 0
            replay_y = lk_lista_y[i_y]  # vetor 6x1 salvo
            # sobrescreve só os componentes atacados
            if attacked_y_idx.size > 0:
                yk[attacked_y_idx, 0] = replay_y[attacked_y_idx, 0]
            i_y += 1

        if len(lk_lista_u) > 0:
            if i_u >= len(lk_lista_u):
                i_u = 0
            replay_u = lk_lista_u[i_u]  # vetor 4x1 salvo
            if attacked_u_idx.size > 0:
                uk[attacked_u_idx, 0] = replay_u[attacked_u_idx, 0]
            i_u += 1

    # marca tempo de ataque
    if kr < x <= kf:
        intervalos_replay.append(x)
        time_attack_replay.append(1)
    else:
        time_attack_replay.append(0)

    # salva para plots (converte para float escalar)
    soc_replay_lista_sensores.append(yk[0, 0])
    kWh_replay_lista_sensores.append(yk[1, 0])
    kW_replay_lista_sensores.append(yk[2, 0])
    tensao_replay_lista_sensores.append(yk[3, 0])
    corrente_replay_lista_sensores.append(yk[4, 0])
    kVA_replay_lista_sensores.append(yk[5, 0])
    kW_ref_replay_atuadores.append(uk[2, 0])
    idling_kW_replay_atuadores.append(uk[3, 0])
    soc_max_replay_atuadores.append(uk[0, 0])
    soc_min_replay_atuadores.append(uk[1, 0])

    # retorna valores se precisar
    return soc_ataque, kWh_bateria, kW_bateria[0], tensao_bateria[0], corrente_bateria[0], kVA_bateria, kW_ref, Idling_kW, soc_max, soc_min

